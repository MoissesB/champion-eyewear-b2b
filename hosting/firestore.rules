rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clients/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'business', 'country', 'status', 'access', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.access == 'all'
        && request.resource.data.business is string
        && request.resource.data.business.size() > 0
        && request.resource.data.business.size() <= 120
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0
        && request.resource.data.country.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /events/{eventId} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/clients/$(uid))
          && get(/databases/$(database)/documents/clients/$(uid)).data.email == request.auth.token.email
          && request.resource.data.keys().hasOnly(['kind', 'resourceType', 'resourceId', 'createdAt'])
          && request.resource.data.kind in ['login', 'visit', 'download']
          && request.resource.data.resourceType is string
          && request.resource.data.resourceType.size() <= 24
          && request.resource.data.resourceId is string
          && request.resource.data.resourceId.size() <= 160
          && request.resource.data.createdAt == request.time
          && (request.resource.data.kind != 'download'
            || get(/databases/$(database)/documents/clients/$(uid)).data.status == 'approved');
        allow read, update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
