// Add this file to the Sheet-bound Champion Apps Script project.
// Install EmailBridge.html; deploy the web app under the Champion-owned Sheet.
const CHAMPION_PORTAL_URL = 'https://champion-innova.com/clientes/';
const CHAMPION_AUTH_PROJECT = 'champion-portal-opticas';

function championSheet_() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Clientes');
  if (!sheet) throw new Error('Falta la pestaña Clientes');
  return sheet;
}

function championApprovedRow_(email) {
  const sheet = championSheet_();
  const last = sheet.getLastRow();
  if (last < 2) return 0;
  const rows = sheet.getRange(2, 1, last - 1, 2).getValues();
  const matches = [];
  rows.forEach((row, index) => {
    if (String(row[0]).trim().toLowerCase() === email) matches.push({row: index + 2, access: String(row[1]).trim().toUpperCase()});
  });
  return matches.length === 1 && matches[0].access === 'APROBADO' ? matches[0].row : 0;
}

function championRequestKey_(email) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, email);
  return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/, '');
}

function championCodeKey_(code) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, code);
  return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/, '');
}

function championEmailHtml_(link, language) {
  const en = language === 'en';
  const headline = en ? 'Your Champion library is ready' : 'Tu biblioteca Champion te espera';
  const intro = en ? 'Use the button below to enter the private resource library for optical stores.' : 'Usa el botón para entrar a la biblioteca privada de recursos para ópticas.';
  const button = en ? 'Open my library' : 'Entrar a mi biblioteca';
  const note = en ? 'This link is personal and expires shortly. If you did not request it, you can ignore this email.' : 'Este enlace es personal y vence pronto. Si no lo solicitaste, puedes ignorar este correo.';
  // The only variable inserted into HTML is an Identity Toolkit URL generated by Google.
  const safeLink = String(link).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  return '<!doctype html><html><body style="margin:0;background:#f3f5f8;font-family:Arial,Helvetica,sans-serif;color:#162044">' +
    '<div style="max-width:560px;margin:32px auto;background:#ffffff;border-radius:18px;overflow:hidden;border:1px solid #e1e5ec">' +
    '<div style="padding:26px 34px;background:#101a43;color:#ffffff"><div style="font-size:25px;font-weight:800;letter-spacing:.02em">Champion</div><div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#d6dcef">Eyewear · Innova</div></div>' +
    '<div style="padding:35px 34px"><div style="color:#cf1735;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Champion para ópticas</div>' +
    '<h1 style="font-size:28px;line-height:1.15;margin:14px 0;color:#101a43">' + headline + '</h1>' +
    '<p style="font-size:15px;line-height:1.6;color:#4b5870">' + intro + '</p>' +
    '<p style="margin:30px 0"><a href="' + safeLink + '" style="display:inline-block;padding:14px 24px;background:#cf1735;color:#ffffff;text-decoration:none;border-radius:30px;font-weight:700">' + button + '</a></p>' +
    '<p style="font-size:12px;line-height:1.5;color:#728099">' + note + '</p></div>' +
    '<div style="padding:17px 34px;background:#f7f8fa;color:#69758a;font-size:11px">Champion Eyewear · Innova Eyewear</div></div></body></html>';
}

function requestPortalLink(input) {
  const email = String(input && input.email || '').trim().toLowerCase();
  const generic = {sent: true};
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) return generic;
  if (!championApprovedRow_(email)) return generic;
  const key = 'link_' + championRequestKey_(email);
  const cache = CacheService.getScriptCache();
  if (cache.get(key)) return generic;
  const ticket = Utilities.getUuid();
  const response = UrlFetchApp.fetch('https://identitytoolkit.googleapis.com/v1/accounts:sendOobCode', {
    method: 'post',
    muteHttpExceptions: true,
    contentType: 'application/json',
    headers: {Authorization: 'Bearer ' + ScriptApp.getOAuthToken()},
    payload: JSON.stringify({
      requestType: 'EMAIL_SIGNIN',
      email: email,
      continueUrl: CHAMPION_PORTAL_URL + '?ticket=' + encodeURIComponent(ticket),
      canHandleCodeInApp: true,
      returnOobLink: true,
      targetProjectId: CHAMPION_AUTH_PROJECT
    })
  });
  if (response.getResponseCode() !== 200) throw new Error('No se pudo generar el enlace de acceso. Código ' + response.getResponseCode() + ': ' + response.getContentText().slice(0, 500));
  const generatedLink = JSON.parse(response.getContentText()).oobLink;
  const link = generatedLink && generatedLink.replace(/([?&])continueUrl=[^&]*/, function(_, prefix) {
    return prefix + 'continueUrl=' + encodeURIComponent(CHAMPION_PORTAL_URL + '?ticket=' + ticket);
  });
  if (!link) throw new Error('No se recibió el enlace de acceso');
  const codeMatch = /[?&]oobCode=([^&#]+)/.exec(link);
  if (!codeMatch) throw new Error('El enlace de acceso no contiene un código');
  cache.put('ticket_' + ticket, JSON.stringify({email: email, codeKey: championCodeKey_(decodeURIComponent(codeMatch[1]))}), 21600);
  const en = input.language === 'en';
  MailApp.sendEmail({
    to: email,
    subject: en ? 'Your private Champion access link' : 'Tu enlace privado a recursos Champion',
    body: (en ? 'Open your Champion library: ' : 'Entra a tu biblioteca Champion: ') + link,
    htmlBody: championEmailHtml_(link, input.language),
    name: 'Champion Eyewear | Innova'
  });
  cache.put(key, '1', 90);
  return generic;
}

function resolvePortalTicket(input) {
  const ticket = String(input && input.ticket || '');
  const code = String(input && input.oobCode || '');
  if (!/^[0-9a-f-]{36}$/i.test(ticket) || !code || code.length > 2048) return {email: ''};
  const saved = CacheService.getScriptCache().get('ticket_' + ticket);
  if (!saved) return {email: ''};
  const entry = JSON.parse(saved);
  if (entry.codeKey !== championCodeKey_(code)) return {email: ''};
  return {email: championApprovedRow_(entry.email) ? entry.email : ''};
}

function championLookupUser_(idToken) {
  const key = PropertiesService.getScriptProperties().getProperty('FIREBASE_WEB_API_KEY');
  if (!key) throw new Error('Falta FIREBASE_WEB_API_KEY en Script Properties');
  const response = UrlFetchApp.fetch('https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=' + encodeURIComponent(key), {
    method: 'post', muteHttpExceptions: true, contentType: 'application/json',
    payload: JSON.stringify({idToken: idToken})
  });
  if (response.getResponseCode() !== 200) throw new Error('Sesión inválida');
  const user = JSON.parse(response.getContentText()).users[0];
  if (!user || !user.emailVerified) throw new Error('Correo no verificado');
  const claims = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(idToken.split('.')[1])).getDataAsString());
  if (claims.firebase?.sign_in_provider !== 'password') throw new Error('Usa el enlace recibido por correo');
  return {uid: user.localId, email: String(user.email).trim().toLowerCase()};
}

function confirmPortalSession(input) {
  const token = String(input && input.idToken || '');
  if (token.length < 100 || token.length > 10000) throw new Error('Sesión inválida');
  const user = championLookupUser_(token);
  const row = championApprovedRow_(user.email);
  const status = row ? 'approved' : 'suspended';
  const url = firestoreUrl_('clients/' + encodeURIComponent(user.uid)) +
    '?updateMask.fieldPaths=email&updateMask.fieldPaths=status&updateMask.fieldPaths=access';
  googleFetch_(url, {method: 'patch', contentType: 'application/json',
    payload: JSON.stringify({fields: {email: {stringValue: user.email}, status: {stringValue: status}, access: {stringValue: 'all'}}})});
  if (row) championSheet_().getRange(row, 8).setValue(user.uid);
  return {approved: Boolean(row)};
}

function doGet(e) {
  const nonce = String(e && e.parameter && e.parameter.nonce || '');
  if (!/^[0-9a-f-]{36}$/.test(nonce)) return HtmlService.createHtmlOutput('Invalid bridge request');
  const page = HtmlService.createTemplateFromFile('EmailBridge');
  page.nonce = nonce;
  return page.evaluate()
    .setTitle('Champion secure gateway')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function doPost(e) {
  const body = JSON.parse(String(e && e.postData && e.postData.contents || '{}'));
  if (body.action === 'requestPortalLink') requestPortalLink(body.payload);
  else if (body.action === 'resolvePortalTicket') resolvePortalTicket(body.payload);
  else if (body.action === 'confirmPortalSession') confirmPortalSession(body.payload);
  else throw new Error('Acción inválida');
  return ContentService.createTextOutput('ok');
}
